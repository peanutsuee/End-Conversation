+test("end_conversation interrupts an active matching turn and only then exposes Chat ended", async () => {
+  const f = await fixture({
+    seed: { ownerUserId: "101", chatId: "201", threadId: "private-thread" },
+  });
+  let rejectTurn;
+  let interruptedThreadId = null;
+  f.codex.runTurn = async function runTurn(threadId, text) {
+    this.active = true;
+    this.activeThread = threadId;
+    this.turns.push({ threadId, text });
+    try {
+      return await new Promise((resolve, reject) => { rejectTurn = reject; });
+    } finally {
+      this.active = false;
+      this.activeThread = null;
+    }
+  };
+  f.codex.interruptActive = async function interruptActive(threadId) {
+    if (!this.active || this.activeThread !== threadId) return false;
+    interruptedThreadId = threadId;
+    this.active = false;
+    this.activeThread = null;
+    rejectTurn(new TurnCancelledError());
+    return true;
+  };
+
+  await f.bridge.handleUpdate(update(1, 101, 201, "正在生成"));
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(f.codex.isTurnActive(), true);
+  await f.bridge.end_conversation("private-thread");
+  await f.bridge.waitUntilIdle();
+
+  assert.equal(interruptedThreadId, "private-thread");
+  assert.deepEqual(f.store.snapshot().endedThreadIds, ["private-thread"]);
+  assert.equal(f.streams.at(-1).text, CHAT_ENDED_TEXT);
+});
